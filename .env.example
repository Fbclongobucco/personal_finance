# Neon Postgres
# Connection string do painel Neon (Connection Details > JDBC).
# Formato: jdbc:postgresql://<host>/<database>?sslmode=require&channelBinding=require
APP_DB_URL=jdbc:postgresql://ep-xxxx-xxxx-pooler.sa-east-1.aws.neon.tech/personal_finance_app?sslmode=require&channelBinding=require
APP_DB_USERNAME=neondb_owner
APP_DB_PASSWORD=

# Segredo de assinatura do JWT (obrigatorio)
APP_JWT_SECRET=

# Usuario administrador criado no bootstrap
APP_ADMIN_EMAIL=admin@personalfinance.local
APP_ADMIN_PASSWORD=admin123
